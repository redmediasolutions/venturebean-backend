---
// Example: one page per category, e.g. /category/news
import { getCategoryBySlug, getPosts } from "../../lib/cms";

export const prerender = false;

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(slug) : null;
if (!category) return Astro.redirect("/404");
const posts = await getPosts({ category: category.slug });
---

<h1>{category.name}</h1>
{category.description && <p>{category.description}</p>}
<ul>
  {posts.map((p) => <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>)}
</ul>
